{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install PKB",
            "type": "shell",
            "command": "python -m pip install -e .",
            "group": "build"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "pytest",
            "group": "test"
        },
        {
            "label": "Ruff Check",
            "type": "shell",
            "command": "ruff check .",
            "group": "test"
        },
        {
            "label": "Ruff Format",
            "type": "shell",
            "command": "ruff format .",
            "group": "build"
        },
        {
            "label": "Git Status",
            "type": "shell",
            "command": "git status"
        }
    ]
}
